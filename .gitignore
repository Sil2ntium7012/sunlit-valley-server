# ─────────────────────────────────────────────
#  Sunlit Valley 서버 - Git 추적 제외 목록
#  설정 파일만 공유하고, 월드/모드/런타임은 각자 보관
# ─────────────────────────────────────────────

# 월드 데이터 (절대 올리지 않음 - 충돌 시 월드 손상)
world/
world_nether/
world_the_end/
backups/

# 모드 jar 및 런타임 (서버팩으로 각자 확보)
# ※ mods/ 대신 mods/* 로 적어야 아래에서 예외(!)를 걸 수 있습니다.
#    (폴더 자체를 제외하면 git 이 안으로 들어가지 않아 예외가 안 먹습니다)
mods/*
libraries/
versions/
*.jar
*.jar.log

# 서버 시작 스크립트 (git이 실행 중에 덮어쓰면 안 되므로 제외)
start-server.bat

# ServerStarterJar / Forge 가 자동 생성하는 것들
run.bat
run.sh
run.ps1
user_jvm_args.txt
rhino.local.properties
installer.log
.serverstarter/

# 첫 실행 때 자동 생성되는 폴더들
configureddefaults/
journeymap/
easy_npc/
modernfix/
quests_structures/
moonlight-global-datapacks/
local/
.mixin.out/
.cache/
debug/

# 서버가 스스로 관리하는 파일 (양쪽에서 달라지면 충돌남)
eula.txt
ops.json
whitelist.json
usercache.json
usernamecache.json
banned-players.json
banned-ips.json
logs/
crash-reports/

# 자바 자동 설치본
.jabba/
jdk/

# 로그 / 임시
*.log
*.log.gz

# OS 잡파일
Thumbs.db
desktop.ini
.DS_Store

# ─────────────────────────────────────────────
#  서버팩에 없는, 우리가 나중에 추가한 모드만 git 으로 같이 보냅니다.
#  (친구 서버는 git 으로 설정을 받아가는데 mods/ 가 통째로 제외돼 있어서
#   여기 적지 않으면 그 모드만 서버에 안 들어갑니다)
#  ※ 예외(!)는 위의 *.jar 규칙보다 반드시 뒤에 있어야 합니다.
# ─────────────────────────────────────────────
!mods/securetrade-forge-1.3.0-1.20.1.jar
